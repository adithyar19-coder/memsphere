# ==========================================================
# MemSphere — root .env.example
# Copy to `.env` at the folders that need it (see README).
# Never commit real .env files.
# ==========================================================

# ---- Supabase (from your Supabase project → Settings → API) ----
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---- Google Gemini (from https://aistudio.google.com/apikey) ----
# One key powers both the LLM (Gemini 1.5 Flash) and embeddings (text-embedding-004).
GEMINI_API_KEY=your-gemini-api-key

# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- Client (Vite requires VITE_ prefix) ----
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_API_URL=http://localhost:5000
